root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
csharp_language_version = latest

csharp_indent_case_contents = true
csharp_indent_switch_labels = true

csharp_style_namespace_declarations = file_scoped:warning

csharp_prefer_braces = true:warning

dotnet_style_nullable_reference_types = true:warning

csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning


csharp_using_directive_placement = outside_namespace:warning

csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:warning

csharp_style_expression_bodied_methods = false:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent

csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning

dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning

dotnet_naming_rule.private_members_with_underscore.symbols = private_fields
dotnet_naming_rule.private_members_with_underscore.style = prefix_underscore
dotnet_naming_rule.private_members_with_underscore.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_styles.prefix_underscore.capitalization = camel_case
dotnet_naming_styles.prefix_underscore.required_prefix = _

[*.{csproj,props,targets,xml}]
indent_size = 4

[*.json]
indent_size = 4

[*.{yml,yaml}]
indent_size = 4